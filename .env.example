# Настройки DocHub Architect Tool.
# Скопируйте в .env рядом с этим файлом и поправьте под себя.
# .env в .gitignore: у каждой установки свои пути и свой токен.

# --- Пути -------------------------------------------------------------------

# Корень архитектурного репозитория (клон DocHub-репозитория компании)
DOCHUB_REPO_ROOT=C:/repos/architectural-repository

# Корневой манифест. Если не задан, ищется в <репозиторий>/architecture/dochub.yaml
# DOCHUB_MANIFEST=C:/repos/architectural-repository/architecture/dochub.yaml

# Доменная схема компании: домены, ограниченные контексты, поддомены
DOCHUB_DDD_PATH=C:/repos/architectural-repository/ddd.drawio

# Каталог, где лежат репозитории сервисов. Нужен, только если схему сверяют с кодом
# DOCHUB_PROJECTS_ROOT=C:/repos

# --- GitLab -----------------------------------------------------------------

# Токен со scope api. Нужен только для создания merge request:
# без него ветка всё равно уходит, а MR создаётся руками по ссылке из push
GITLAB_TOKEN=

# Как настроен origin репозитория: https или ssh.
# Сервер сам ничего не клонирует, но по протоколу понимает, чего ждать:
# при https нужен токен или сохранённые учётные данные, при ssh — ключ
DOCHUB_REMOTE_PROTOCOL=https

# Ветка, в которую создаётся merge request
DOCHUB_TARGET_BRANCH=main

# Префикс рабочей ветки: к нему дописывается название схемы
DOCHUB_BRANCH_PREFIX=feature/

# Шаблон сообщения коммита. Доступна одна подстановка — {schema}
DOCHUB_COMMIT_TEMPLATE=Добавление схемы {schema}

# Кто отвечает за merge request и кто ревьюит (username в GitLab, через запятую)
# DOCHUB_MR_ASSIGNEE=ivanov
# DOCHUB_MR_REVIEWERS=petrov,sidorov

# Схлопывать коммиты при мерже
DOCHUB_MR_SQUASH=false

# Удалять ветку после мержа
DOCHUB_MR_REMOVE_SOURCE_BRANCH=true

# --- Поведение --------------------------------------------------------------

# Автоматический режим: агент сам закрывает вопросы брифа умолчаниями и
# доводит работу до merge request, не спрашивая подтверждения на публикацию.
# Мерж всегда остаётся человеку.
DOCHUB_AUTOMODE=false

# --- Необязательное ---------------------------------------------------------

# Draw.io Desktop — нужен только для выгрузки схемы в PNG или PDF
# DRAWIO_PATH=C:/Program Files/draw.io/draw.io.exe
