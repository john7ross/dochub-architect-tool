@startuml flow
' ASCII labels on purpose - see component.puml
title Transferring a schema into the architecture repository

skinparam responseMessageBelowArrow true

actor Architect as user
participant "MCP client" as agent
participant "MCP server" as mcp
participant "Preview" as preview
database "Architecture\nrepository" as repo
participant GitLab as gitlab
database "Domain schema (link or file)" as ddd
database "Service repository" as code

== Preparation ==

user -> agent: Transfer this schema into DocHub
agent -> mcp: dochub_workspace()
mcp --> agent: settings, where each came from, automode

alt Something is missing in .env
  agent -> user: Asks only for what is missing
  user --> agent: names it once
  agent -> mcp: dochub_workspace(save=true)
end

agent -> mcp: dochub_repo_sync(update=true, branch)
mcp -> repo: ls-remote, fetch, fast-forward, work branch
mcp -> ddd: downloads the domain schema when it is given by link
note right of mcp
  The only step that goes to the network for the schema.
  Everything after this reads the downloaded copy.
end note
mcp --> agent: reachable, behind, uncommitted, branch, ddd refreshed

alt Repository unreachable
  agent -> user: The reason, quoted: VPN, proxy or rights
end

agent -> mcp: dochub_lessons()
mcp --> agent: rules confirmed on earlier schemas
agent -> mcp: dochub_brief(schema, query, project_root)
mcp -> code: reads the service repository when project_root is given
mcp --> agent: facts, code discrepancies, and the questions nothing answers

alt The DrawIO file has several pages
  mcp --> agent: the page list with element counts
  agent -> user: Which page do we take? They are different diagrams
  user --> agent: names the page
end

alt Diagram is a logical one (sequence, activity)
  mcp --> agent: rejected with an explanation
  agent -> user: A component set cannot be derived from this
end

alt automode is off
  agent -> user: The brief - every question with its source
  user --> agent: answers in one message
else automode is on
  agent -> agent: applies the defaults from the brief
end

== Reconciliation with the code (only when sources are given) ==

agent -> user: Shows the discrepancies the brief already found, with file and line
user --> agent: decides what goes in and what stays out
note right of agent
  The full list, when it did not fit into the brief:
  dochub_reconcile_with_code(schema, project)
end note

== Building ==

agent -> mcp: dochub_search_components(query)
mcp --> agent: existing components to reuse
agent -> mcp: dochub_locate_owner(ids)
mcp --> agent: which subdomain owns them
agent -> mcp: dochub_draft_from_schema(own_root, ...)
mcp --> agent: draft YAML, foreign components listed separately

== Agreement loop ==

agent -> mcp: dochub_preview(schema, yaml)
mcp -> preview: start
preview --> agent: address
agent -> user: Open the preview and tell me what to change

loop until the user confirms
  user -> preview: reviews the split screen
  user --> agent: comments
  agent -> repo: edits the YAML
  preview -> preview: picks up the change automatically
end

== Publication ==

agent -> mcp: dochub_check_registration(repo, yaml)
mcp --> agent: what is missing in shared and foreign files
agent -> mcp: dochub_register_schema(plan, apply=false)
mcp --> agent: plan, foreign files marked
agent -> user: These foreign subdomains will be touched - agreed?
user --> agent: confirms
agent -> mcp: dochub_register_schema(apply=true)
agent -> mcp: dochub_publish(schema_name, confirmed=true)
note right: In automode the confirmation is not asked for,\nand the answer says so
mcp -> repo: branch, commit by the template from the settings
mcp -> gitlab: push, merge request with assignee and reviewers
gitlab --> user: merge request link
agent -> user: Who approves, and whether the branch is removed - decided by a human

agent -> mcp: dochub_record_lessons(confirmed=true)
note right: What was learned is stored\nand reused on the next schema

@enduml
